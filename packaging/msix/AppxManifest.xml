<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for the Microsoft Store version of InstaFind.
  packaging/msix/make_layout.py fills the {{…}} values from identity.json,
  Cargo.toml and the CPU, once per package (x64, x86, arm64).
  src/store.rs has tests that keep this file and the program in agreement
  (StartupTask TaskId, the alias, the exe name, runFullTrust, MinVersion).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Description>Find files on your PC as you type, in Arabic or English, and search inside documents.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ar" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <!-- A classic Win32 program: indexer, folder watchers, global hotkeys,
         tray icon, floating box. Explained in the certification notes
         (docs/distribution/microsoft-store.md). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="InstaFind" Executable="bahth.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="Find files on your PC as you type, in Arabic or English, and search inside documents."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="InstaFind"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- `instafind.exe -s "query"` from a terminal, Flow Launcher, scripts. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="bahth.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="instafind.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- Start with Windows (Options menu). Off until the program asks
             for it; the user can turn it off in Settings > Apps > Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="bahth.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="InstaFindStartup" Enabled="false" DisplayName="{{DISPLAY_NAME}}" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>

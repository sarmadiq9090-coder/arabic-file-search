            "hash": "2695ff21658635c6e5cbc70d375f2a758ab3500da4dfd0cd8b48881d6754dfd0"
        },
        "arm64": {
            "url": "https://github.com/sarmadiq9090-coder/arabic-file-search/releases/download/v1.0.0/bahth-arm64.exe#/bahth.exe",
            "hash": "6183b285cd20bf447869b908f049b19c93400c0890df1df4357f9ed0f2c6d0ac"
        }
    },
    "bin": [
        "bahth.exe",
        ["bahth.exe", "instafind"]
    ],
    "shortcuts": [
        ["bahth.exe", "InstaFind"]
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    $run = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
            "    $value = (Get-ItemProperty -Path $run -Name 'BahthSari' -ErrorAction SilentlyContinue).BahthSari",
            "    if ($value -and $value.ToLower().Contains((Split-Path $dir).ToLower())) {",
            "        Remove-ItemProperty -Path $run -Name 'BahthSari' -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sarmadiq9090-coder/arabic-file-search/releases/download/v$version/bahth.exe"
            },
            "32bit": {
                "url": "https://github.com/sarmadiq9090-coder/arabic-file-search/releases/download/v$version/bahth-x86.exe#/bahth.exe"
            },
            "arm64": {
                "url": "https://github.com/sarmadiq9090-coder/arabic-file-search/releases/download/v$version/bahth-arm64.exe#/bahth.exe"
            }
        }
    }
